<Window x:Class="CameraControl.windows.ImportProjectDlg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:T="clr-namespace:CameraControl.Core.Translation;assembly=CameraControl.Core"
        xmlns:local="clr-namespace:CameraControl.windows"
        mc:Ignorable="d"
        Title="{T:TranslateExtension ImportProjectToolTip}"
        ResizeMode="NoResize"
        Height="300" Width="500"
        MinHeight="300" MinWidth="500"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Project file" Margin="4"/>
        <TextBox Grid.Column="1" Name="tb_fileName" Margin="4" TextChanged="tb_fileName_TextChanged" KeyUp="tb_fileName_KeyUp" />
        <Button Grid.Column="2" Name="btn_browse" Click="btn_browse_Click" Margin="4">Browse...</Button>

        <CheckBox Name="cb_clear_scripts" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="4">
            <Label>Close tcl scripts before import</Label>
        </CheckBox>
        <CheckBox Name="cb_clear_objects" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="4">
            <Label>Unregister external services/devices before import</Label>
        </CheckBox>

        <ScrollViewer Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="4" Visibility="{Binding HasErrors}">
            <TextBlock Text="{Binding Errors}" TextWrapping="Wrap"/>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3"  Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button Name="btn_import" Click="btn_import_Click" IsDefault="True" Margin="4" IsEnabled="{Binding ProjectFileExists}">Import</Button>
            <Button Name="btn_cancel" IsCancel="True" Margin="4">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
