<UserControl x:Class="CameraControl.windows.ScriptWndXmlScript"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CameraControl.windows"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="268*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="142*" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="{Binding FullScriptTitle}">
            <Grid>
                <avalonedit:TextEditor SyntaxHighlighting="XML" Background="White" Name="textEditor" ShowLineNumbers="True" FontSize="16" IsReadOnly="{Binding IsRunning}" />
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Output">
            <Grid>
                <ListBox Name="lst_output" />
            </Grid>
        </GroupBox>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Name="gridSplitter1" />
    </Grid>
</UserControl>
